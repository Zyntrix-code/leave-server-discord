<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Server Leave</title>
    <meta name="description" content="Server Leave - Fast, secure, and modern bulk Discord server manager and cleaner.">
    <meta name="theme-color" content="#000000">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap">
    </noscript>
    <style>
        :root {
            --bg-page: #000000;
            --bg-surface: #0A0A0A;
            --bg-input: #000000;
            --border-subtle: #1C1C1C;
            --border-medium: #2A2A2A;
            --border-focus: #555555;
            --text-primary: #FFFFFF;
            --text-secondary: #D4D4D4;
            --text-muted: #8E8E8E;
            --btn-bg: #FFFFFF;
            --btn-text: #000000;
            --danger-color: #EF4444;
            --danger-glow: rgba(239, 68, 68, 0.25);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: var(--bg-page);
            color: var(--text-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: absolute;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.03) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
        }

        .login-box {
            position: relative;
            z-index: 1;
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            padding: 44px 36px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
            text-align: center;
            width: 100%;
            max-width: 440px;
            animation: fadeIn 0.4s ease-out;
            transition: border-color 0.3s;
        }

        .login-box:hover {
            border-color: var(--border-medium);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(16px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h2 {
            margin-bottom: 8px;
            font-size: 24px;
            font-weight: 800;
            color: var(--text-primary);
            letter-spacing: -0.3px;
        }

        p {
            color: var(--text-secondary);
            font-size: 14px;
            margin-bottom: 24px;
        }

        .input-group {
            text-align: left;
            margin-bottom: 22px;
            position: relative;
        }

        .label-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        label {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .label-hint {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        input {
            width: 100%;
            padding: 14px 44px 14px 16px;
            border-radius: 10px;
            border: 1px solid var(--border-subtle);
            background: var(--bg-input);
            color: #FFFFFF;
            font-size: 14px;
            font-family: 'JetBrains Mono', monospace;
            box-sizing: border-box;
            outline: none;
            transition: all 0.25s ease;
        }

        input::placeholder {
            color: var(--text-muted);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
        }

        input:focus {
            border-color: var(--border-focus);
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
        }

        input.input-invalid {
            border-color: var(--danger-color) !important;
            box-shadow: 0 0 0 3px var(--danger-glow) !important;
            animation: inputShake 0.4s ease;
        }

        @keyframes inputShake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-4px); }
            40%, 80% { transform: translateX(4px); }
        }

        .toggle-btn {
            position: absolute;
            right: 12px;
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 6px;
            cursor: pointer;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s, background 0.2s;
            width: auto;
            box-shadow: none;
        }

        .toggle-btn:hover {
            color: #FFFFFF;
            background: rgba(255, 255, 255, 0.08);
            transform: none;
            box-shadow: none;
        }

        .field-error {
            display: none;
            align-items: center;
            gap: 8px;
            margin-top: 8px;
            padding: 8px 12px;
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 8px;
            font-size: 12px;
            color: #FF8585;
            animation: slideDown 0.25s ease-out;
        }

        .field-error.visible {
            display: flex;
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .error-alert {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.4);
            padding: 12px 16px;
            border-radius: 12px;
            color: #FFFFFF;
            font-size: 13px;
            margin-bottom: 20px;
            text-align: left;
            animation: shake 0.4s ease-in-out;
        }

        .error-icon {
            display: flex;
            align-items: center;
            flex-shrink: 0;
        }

        .error-text {
            color: #FF8A8A;
            line-height: 1.4;
            font-weight: 500;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-4px); }
            40%, 80% { transform: translateX(4px); }
        }

        .btn-submit {
            background: var(--btn-bg);
            color: var(--btn-text);
            border: none;
            padding: 14px 20px;
            border-radius: 10px;
            cursor: pointer;
            width: 100%;
            font-size: 15px;
            font-family: inherit;
            font-weight: 800;
            transition: all 0.25s ease;
            box-shadow: 0 4px 15px rgba(255, 255, 255, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-submit:hover {
            background: #E5E5E5;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 255, 255, 0.25);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .btn-submit:disabled {
            opacity: 0.65;
            cursor: not-allowed;
            transform: none !important;
            box-shadow: none !important;
        }

        .btn-spinner {
            display: none;
            width: 18px;
            height: 18px;
            border: 2px solid rgba(0, 0, 0, 0.25);
            border-top: 2px solid #000000;
            border-radius: 50%;
            animation: btnSpin 0.7s linear infinite;
        }

        @keyframes btnSpin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .warning {
            margin-top: 24px;
            font-size: 12px;
            color: var(--text-secondary);
            background: #111111;
            border: 1px solid var(--border-subtle);
            padding: 12px 14px;
            border-radius: 10px;
            line-height: 1.6;
            text-align: left;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .warning-icon {
            display: flex;
            align-items: center;
            flex-shrink: 0;
            margin-top: 2px;
            color: var(--text-muted);
        }

        .warning strong {
            color: #FFFFFF;
        }
    </style>
</head>
<body>

    <main class="login-box">
        <h2>Sign In</h2>
        <p>Server Leave — Leave Server</p>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error-alert">
                <span class="error-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </span>
                <div class="error-text"><%= error %></div>
            </div>
        <% } %>

        <!-- novalidate disables browser default tooltip -->
        <form action="/fetch-servers" id="loginForm" method="POST" novalidate>
            <div class="input-group">
                <div class="label-row">
                    <label for="tokenInput">Discord Account Token</label>
                    <span class="label-hint">User Account</span>
                </div>
                <div class="input-wrapper">
                    <input type="password" id="tokenInput" name="token" placeholder="Paste your token here..." autocomplete="off" spellcheck="false">
                    <button type="button" class="toggle-btn" id="toggleToken" title="Toggle token visibility" aria-label="Toggle token visibility">
                        <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <div class="field-error" id="fieldError">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span id="fieldErrorMsg">Please enter your Discord token to continue</span>
                </div>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">
                <div class="btn-spinner" id="btnSpinner"></div>
                <span id="btnText">Sign In & Load Servers</span>
            </button>
        </form>

        <div class="warning">
            <span class="warning-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </span>
            <div>
                <strong>Security Notice:</strong> Your token runs strictly locally on your machine and is never shared or stored remotely.
            </div>
        </div>
    </main>

